#!/usr/bin/env bash
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/opt/podman/bin:$PATH"
resources="$(CDPATH= cd -- "$(dirname -- "$0")/../Resources" && pwd)"
controller="$resources/Sandbox Desktop"
if [[ ! -x "$controller" ]]; then
  osascript -e 'display alert "Bioinformatics Sandbox" message "Build the desktop launcher with scripts/build-desktop.sh before running this source app." as critical'
  exit 1
fi
exec "$controller" "Bioinformatics Sandbox" "bioinformatics-sandbox" "" "" "$resources/Bioinformatics Sandbox.command"
