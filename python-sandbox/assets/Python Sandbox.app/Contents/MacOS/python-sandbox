#!/usr/bin/env bash
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/opt/podman/bin:$PATH"
resources="$(CDPATH= cd -- "$(dirname -- "$0")/../Resources" && pwd)"
controller="$resources/Sandbox Desktop"
if [[ ! -x "$controller" ]]; then
  osascript -e 'display alert "Python Sandbox" message "Build the desktop launcher with scripts/build-desktop.sh before running this source app." as critical'
  exit 1
fi
exec "$controller" "Python Sandbox" "python-sandbox" "3.13" "Python version" "$resources/Python Sandbox.command"
