#!/usr/bin/env bash
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/opt/podman/bin:$PATH"
resources="$(CDPATH= cd -- "$(dirname -- "$0")/../Resources" && pwd)"
code_dir="$(CDPATH= cd -- "$resources/../../.." && pwd)"
agent="$(cat "$code_dir/.bioinformatics-sandbox-agent")"
exec "$resources/Sandbox Desktop" "Bioinformatics Sandbox" "bioinformatics-sandbox" "" "" "$code_dir/run-bioinformatics-sandbox.sh" "$(dirname -- "$(dirname -- "$code_dir")")" "$agent"
